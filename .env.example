# ==============================================================
# .env.example: copy to .env and fill in the values.
#   cp .env.example .env
# .env is listed in .gitignore, so your secrets never reach git.
# Docker Compose and the app (pydantic-settings) both read .env.
# ==============================================================

# --- Application ---
APP_NAME="Network Asset API"
DEBUG=false
# Browser front ends allowed to call the API, as a JSON list. Empty = none.
CORS_ORIGINS=[]

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=network_asset_db
# "localhost" when you run the app on your machine (uvicorn) against the
# Compose database. Inside Compose the app always uses the service name "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Security ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-run-the-command-above
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- pgAdmin (only with: docker compose --profile tools up -d) ---
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=change-me-too
